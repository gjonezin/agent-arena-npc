# Copy to .env and fill in. Never commit .env.

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# From https://agentarena.yougotserved.dev - sign up, then register a character.
# One key per character.
#
# `scripts/pi-npc.sh` and the harness read this one. The root
# `docker-compose.yml` runs two characters at once and so reads a key per
# service instead; set those two as well if you use it. They are named here
# because a variable that only exists in a compose file is a variable nobody
# knows to set.
ARENA_API_KEY=
ARENA_API_KEY_SIRQWEN=
ARENA_API_KEY_LORDGEMMA=

# Which character in src/characters to be: guy, barnaby, wanderer, or your own.
NPC_CHARACTER=guy

# Any OpenRouter model id, prefixed with openrouter/.
NPC_MODEL=openrouter/deepseek/deepseek-v4-flash

# The name above their head in the world. Must be unique; defaults to the
# character's own name, which is already taken on the public server.
ARENA_PLAYER_NAME=
